<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="paperformat_label_10x8cm" model="report.paperformat">
            <field name="name">Label 10 x 8 cm</field>
            <field name="default" eval="False"/>
            <field name="format">custom</field>
            <field name="page_width">100</field>
            <field name="page_height">80</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">3</field>
            <field name="margin_bottom">3</field>
            <field name="margin_left">3</field>
            <field name="margin_right">3</field>
            <field name="dpi">90</field>
        </record>
        <record id="action_report_label_10x8cm" model="ir.actions.report">
            <field name="name">Product Label 10x8</field>
            <field name="model">cdp.print.product.label.stock</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">agrotem_product_print_label.cdp_report_producttemplatelabel_10x8cm</field>
            <field name="paperformat_id" ref="agrotem_product_print_label.paperformat_label_10x8cm"/>
            <field name="print_report_name">
                'Product Label_%s' % (object.cdp_product_id.default_code or '')
            </field>
        </record>
    </data>
</odoo>