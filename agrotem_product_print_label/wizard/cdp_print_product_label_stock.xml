<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_cdp_print_product_label_stock_wizard" model="ir.ui.view">
            <field name="name">view.cdp.print.product.label.stock.wizard</field>
            <field name="model">cdp.print.product.label.stock</field>
            <field name="arch" type="xml">
                <form string="Print Label">
                    <group>
                        <field name="cdp_move_id" invisible="1"/>
                        <field name="cdp_product_id" readonly="1"/>
                        <field name="cdp_qty"/>
                        <field name="cdp_print_label_qty"/>
                    </group>
                    <footer>
                        <button name="action_print_label"
                            string="Print"
                            type="object"
                            class="btn-primary"/>
                        <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>